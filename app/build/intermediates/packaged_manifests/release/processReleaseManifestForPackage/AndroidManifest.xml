<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.lemoneko.endfieldcharge"
    android:versionCode="1"
    android:versionName="0.1.0" >

    <uses-sdk
        android:minSdkVersion="35"
        android:targetSdkVersion="35" />

    <application
        android:description="@string/xposed_description"
        android:extractNativeLibs="false"
        android:label="@string/app_name"
        android:supportsRtl="true" >
        <activity
            android:name="com.lemoneko.endfieldcharge.ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="com.lemoneko.endfieldcharge.settings.SettingsProvider"
            android:authorities="com.lemoneko.endfieldcharge.settings"
            android:exported="true" />
    </application>

</manifest>